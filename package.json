{
  "name": "mpesa-stk",
  "version": "1.0.0",
  "description": "Production-ready, type-safe TypeScript library for Safaricom M-Pesa STK Push (Lipa na M-Pesa Online) integrations.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "mpesa",
    "daraja",
    "stk-push",
    "safaricom",
    "payments",
    "kenya",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.6.1",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
